# Explainable RAG - environment configuration
# Copy to .env and fill in your values. Never commit .env.

# --- API Keys (generation, HyDE and multimodal summaries; retrieval works without it) ---
OPENAI_API_KEY=

# --- Vector Database (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=explainable_rag

# --- Backend ---
DEBUG=false
LOG_LEVEL=info

# --- Retrieval ---
TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_THRESHOLD=0.1

# --- Hybrid Search (dense + BM25, fused with RRF) ---
USE_HYBRID=true
USE_RERANKER=true
USE_HYDE=false
DENSE_PREFETCH=40
SPARSE_PREFETCH=10
